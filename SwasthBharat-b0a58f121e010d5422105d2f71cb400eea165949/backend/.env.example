# Copy to backend/.env and fill in. Never commit the real .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB Atlas connection string (free tier is fine).
# Atlas -> Cluster -> Connect -> Drivers -> copy the SRV string.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/swasthbharat?retryWrites=true&w=majority

# Set to true to boot an in-process MongoDB instead of connecting to Atlas.
# Handy when the venue wifi is blocking Atlas, or for a quick local run.
# First use downloads a mongod binary (~130 MB), so do it BEFORE the demo.
# When true, MONGO_URI is ignored.
USE_IN_MEMORY_DB=false

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production without this set.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# Required to create doctor or district-officer accounts through /api/auth/register.
# Without it, self-registration can only ever create a field worker (asha) account,
# so nobody can grant themselves access to the whole district's patient data.
SETUP_TOKEN=replace-me-too

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins for CORS and Socket.io.
#
# 5173 = `npm run dev` (Vite dev server). 4173 = `npm run preview` (production build).
# You need BOTH: offline reload and PWA install only work against the preview build, so
# that is also what you should demo from.
#
# Gotcha worth knowing: 4173 must be listed even though Vite proxies /api to this backend.
# Browsers attach an `Origin` header to every non-GET request including same-origin ones,
# and Vite's `changeOrigin` rewrites Host but not Origin — so the backend still sees the
# browser's real origin and CORS still applies. Symptom if you miss it: login fails with
# "Could not log in" while curl against the same endpoint works fine.
#
# For the two-laptop demo, add the API laptop's LAN origins too, e.g.
#   http://192.168.1.5:5173,http://192.168.1.5:4173
#
# If the frontend is deployed to Firebase Hosting (see README.md "Deploying"), add its
# origin too, e.g. https://your-project.web.app — the socket handshake needs it as much as
# the REST calls do, since Socket.io's CORS check reuses this same list.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Demo seed accounts (npm run seed) all share this password.
SEED_PASSWORD=demo1234

# ---------------------------------------------------------------------------
# Firebase phone sign-in (OPTIONAL)
# ---------------------------------------------------------------------------
# Leave all of this blank and nothing breaks: POST /api/auth/firebase answers 501 and
# mobile-number + password login works exactly as before. No Firebase project is needed
# to run the app or to pass any of the verification scripts.
#
# What it adds: an ASHA worker signs in with an SMS code instead of a password. Worth
# having because these users have a phone and often no email, and a password typed on a
# cracked screen in a village is the single most common reason they cannot get in.
#
# How it fits: Firebase only proves the caller controls a phone number. The backend
# exchanges the resulting ID token for this app's OWN JWT, so role, PHC scoping and the
# Socket.io handshake are unchanged and do not depend on Firebase. See
# backend/src/config/firebase.js.

# From the Firebase console: Project settings -> General -> Project ID.
FIREBASE_PROJECT_ID=

# ---- Local development: use the emulator, no project or SMS quota needed ----
# Terminal 1:  firebase emulators:start --only auth
# Terminal 2:  set FIREBASE_PROJECT_ID above (any value, e.g. demo-swasthbharat) and
#              uncomment the line below, then npm run dev:api
#
# The emulator accepts UNSIGNED tokens. That is why the server refuses to start if this is
# set while NODE_ENV=production: anyone could otherwise mint a valid login.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---- Real project: one of these two ----
# Path to a service-account JSON file (Project settings -> Service accounts -> Generate key).
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
#
# Or the same JSON inline, raw or base64, for hosts that only offer env vars.
# CONTAINS A PRIVATE KEY. Never commit it, never paste it into a chat or an issue.
# FIREBASE_SERVICE_ACCOUNT=

# Allow a successful phone sign-in to CREATE an account when none exists.
# Default false, and think before changing it: a verified phone number proves someone owns
# a SIM, not that they are a health worker. With this on, anyone who can receive an SMS can
# create a field-worker account. It can never create a doctor or officer account regardless
# — those read a whole PHC or district and stay behind SETUP_TOKEN.
FIREBASE_ALLOW_SIGNUP=false

# ---------------------------------------------------------------------------
# Background push notifications (OPTIONAL, Firebase Cloud Messaging)
# ---------------------------------------------------------------------------
# Socket.io already delivers a high-risk case to an OPEN dashboard instantly. This covers
# the other case: the doctor's tab is closed. It does not replace the live path, and the
# live-arrival demo is unaffected.
#
# Requires FIREBASE_PROJECT_ID plus credentials above, AND this flag. The two Firebase
# features are independent — a project can have phone sign-in without Web Push, or the
# reverse — so each has its own switch.
#
# The frontend additionally needs VITE_FIREBASE_VAPID_KEY (Firebase console -> Project
# settings -> Cloud Messaging -> Web Push certificates -> Key pair).
#
# ONE DESIGN POINT NOT TO "SIMPLIFY": recipients are computed server-side by querying the
# doctors at the relevant PHC. FCM topics would be far less code, but subscription would
# happen on the client, so any doctor could subscribe to another PHC's topic and receive
# that PHC's patient names. See backend/src/services/pushService.js.
PUSH_NOTIFICATIONS_ENABLED=false

# Device tokens retained per user, oldest evicted first. A doctor legitimately uses one or
# two browsers; beyond that the list is stale tokens costing a wasted send each.
# PUSH_MAX_TOKENS_PER_USER=5

# How long FCM keeps retrying, in seconds. Default 4 hours: a high-risk case is still worth
# knowing about when the phone comes back online, but not the next morning — by then the
# dashboard is the right place to find it.
# PUSH_TTL_SECONDS=14400

# ---------------------------------------------------------------------------
# Chatbot LLM fallback (OPTIONAL, Gemini API)
# ---------------------------------------------------------------------------
# The chatbot IS the rule-based FAQ in shared/chatbot/ — fixed, clinician-reviewable answers
# that work with no network. This ONLY answers the question those rules could not match, and
# only when the device is online. Leave it off and nothing changes: an unmatched question
# gets exactly the same "ask your ASHA worker or visit the PHC" answer it always has.
#
# DEMO-SCALE ONLY. There is no budget cap, no per-caller rate limit, and no response cache —
# deliberately, for a short pitch window on a disposable free-tier key. Do not leave this on
# unattended, and rotate the key afterwards. A free-tier quota does not silently start
# billing you when exhausted: it returns 429, which this feature treats as "answer normally".
#
# Get a key at https://aistudio.google.com/apikey (no billing needed for the free tier).
GEMINI_ENABLED=false
GEMINI_API_KEY=
# Default is gemini-flash-lite-latest: the lite models have the largest FREE-tier daily
# allowance, and a '-latest' alias avoids the 404 you get when a pinned version is retired
# from new-user access. Plenty for rephrasing curated FAQ answers.
# GEMINI_MODEL=gemini-flash-lite-latest
